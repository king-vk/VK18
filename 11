#include <stdio.h>

int main()
{
    int n, i, ack;

    printf("Enter number of frames: ");
    scanf("%d", &n);

    for (i=1; i<=n; i++)
    {
        printf("\nSender: Sending Frame %d\n", i);
        printf("Enter ACK (1 = received, 0 = lost): ");
        scanf("%d", &ack);

        if (ack == 1)
            printf("Receiver: ACK %d received.\n", i);
        else
        {
            printf("Receiver: Frame %d lost.\n", i);
            printf("Sender: Retransmitting Frame %d...\n", i);
            printf("Receiver: ACK %d received.\n", i);
        }
    }

    printf("\nAll frames transmitted successfully.\n");
    return 0;
}
